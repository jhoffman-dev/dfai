{
  "hosting": [
    {
      "target": "web",
      "public": "apps/web/dist",
      "ignore": ["**/.*", "**/.*/**"],
      "rewrites": [
        { "source": "/api/**", "function": { "functionId": "auth", "region": "us-central1" } },
        { "source": "/!(assets)", "destination": "/index.html" },
        { "source": "/!(assets)/**", "destination": "/index.html" }
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            { "key": "Cache-Control", "value": "no-cache" },
            {
              "key": "Content-Security-Policy",
              "value": "script-src 'self'; connect-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
            },
            { "key": "X-Content-Type-Options", "value": "nosniff" },
            { "key": "X-Frame-Options", "value": "DENY" },
            { "key": "Referrer-Policy", "value": "no-referrer" },
            { "key": "Strict-Transport-Security", "value": "max-age=31536000" }
          ]
        },
        {
          "source": "/assets/**",
          "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
        }
      ]
    }
  ],
  "functions": [
    {
      "codebase": "dfai-auth",
      "source": "apps/auth-function",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".git",
        "src",
        "*.local",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ]
    }
  ]
}
