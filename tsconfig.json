{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vitest/globals", "node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "paths": {
      "@dfai/domain": ["./packages/domain/src/index.ts"],
      "@dfai/application": ["./packages/application/src/index.ts"],
      "@dfai/application/testing/sqlite": ["./packages/application/src/testing/sqlite.ts"],
      "@dfai/adapters": ["./packages/adapters/src/index.ts"],
      "@dfai/adapters/pdf": ["./packages/adapters/src/pdf/index.ts"],
      "@dfai/adapters/epub": ["./packages/adapters/src/epub/index.ts"],
      "@dfai/ui": ["./packages/ui/src/index.ts"],
      "@dfai/ui/graph": ["./packages/ui/src/graph/index.ts"],
      "@dfai/ui/testing/settles": ["./packages/ui/src/testing/settles.ts"]
    }
  },
  "include": [
    "./packages/*/src/**/*",
    "apps/*/src/**/*",
    "tools/**/*.ts",
    "*.config.ts",
    "*.config.js"
  ],
  "exclude": ["**/dist", "**/target", "node_modules"]
}
