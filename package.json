{
  "name": "dfai",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @dfai/desktop dev",
    "tauri:dev": "pnpm --filter @dfai/desktop tauri:dev",
    "build": "pnpm --filter @dfai/desktop --filter @dfai/mcp build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "version:set": "node tools/release/version.mjs set",
    "version:check": "node tools/release/version.mjs check",
    "check:chunks": "node tools/ci/check-chunks.mjs",
    "gate": "pnpm format:check && pnpm version:check && pnpm typecheck && pnpm lint && pnpm test:coverage && pnpm build && pnpm check:chunks && pnpm rust:lint && pnpm rust:test",
    "rust:test": "cargo test --manifest-path apps/desktop/src-tauri/Cargo.toml",
    "rust:lint": "cargo clippy --manifest-path apps/desktop/src-tauri/Cargo.toml --all-targets -- -D warnings && cargo fmt --manifest-path apps/desktop/src-tauri/Cargo.toml --check",
    "e2e": "pnpm build && playwright test",
    "perf": "pnpm build && playwright test --config playwright.perf.config.ts --project latency",
    "perf:profile": "pnpm --filter @dfai/desktop exec vite build --minify false && playwright test --config playwright.perf.config.ts --project profile",
    "perf:renders": "pnpm --filter @dfai/desktop exec vite build --minify false && playwright test --config playwright.perf.config.ts --project renders",
    "perf:budgets": "pnpm --filter @dfai/desktop exec vite build --minify false && playwright test --config playwright.perf.config.ts --project budgets",
    "perf:vault": "node tools/perf/make-fixture-vault.ts",
    "smoke:api": "node apps/mcp/scripts/smoke.mjs",
    "design:refs": "node tools/design/refs.ts",
    "shots": "pnpm build && playwright test --config playwright.shots.config.ts",
    "shots:gallery": "playwright test --config playwright.gallery.config.ts",
    "design:compare": "node tools/design/compare.ts",
    "n8n:build": "node tools/n8n/build-workflow.mjs",
    "validate:meeting": "node tools/n8n/validate-meeting.mjs",
    "import:notion-meetings": "node tools/import-notion-meetings.mjs",
    "import:notion-workspace": "node tools/import-notion-workspace.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^5.0.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30.1.0",
    "prettier": "^3.9.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
